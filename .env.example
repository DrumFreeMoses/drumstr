# MoneyDevKit Credentials
# Sign up at https://moneydevkit.com and generate these credentials
# CRITICAL: Back up MDK_MNEMONIC securely (offline storage)

MDK_ACCESS_TOKEN=your_api_key_here
MDK_MNEMONIC=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12
MDK_WEBHOOK_SECRET=your_webhook_secret_here

# DFE Lightning Address (where platform fees go)
DFE_LIGHTNING_ADDRESS=your_lightning_address@walletofsatoshi.com

# Facilitator Lightning Address (where facilitator tips go)
FACILITATOR_LIGHTNING_ADDRESS=facilitator_lightning@walletofsatoshi.com

# Split Configuration (default: 80/20)
FACILITATOR_SPLIT_PERCENT=80
DFE_SPLIT_PERCENT=20

# Nostr Configuration
NOSTR_RELAY=wss://relay.drumstr.app
NOSTR_PUBKEY=npub1xxxxx

# Application
NODE_ENV=development
PORT=3000
